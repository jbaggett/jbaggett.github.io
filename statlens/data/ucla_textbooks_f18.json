      "name": "course",
      "label": "Course",
      "type": "categorical"
    },
    {
      "name": "ucla",
      "label": "UCLA bookstore price ($)",
      "type": "numeric"
    },
    {
      "name": "amazon",
      "label": "Amazon price ($)",
      "type": "numeric"
    }
  ],
  "variableDescriptions": {
    "course": "The subject abbreviation and course number the textbook was required for.",
    "ucla": "Price of a new copy at the UCLA bookstore, in dollars.",
    "amazon": "Price of a new copy on Amazon the same day, in dollars."
  },
  "context": {
    "population": "UCLA courses in Fall 2018",
    "parameter": "the mean difference in price between the bookstore and Amazon",
    "unit": "dollars",
    "nullClaim": "the mean difference in price is zero"
  },
  "inferenceContexts": [
    {
      "test": "paired",
      "var1": "ucla",
      "var2": "amazon",
      "nullValue": 0,
      "alternative": "greater",
      "parameter": "the mean difference in price (UCLA bookstore minus Amazon)",
      "claim": "textbooks cost more at the UCLA bookstore than on Amazon"
    }
  ],
