{
  "id": "ask",
  "name": "iPod Disclosure Experiment",
  "description": "219 sellers of a used iPod known to freeze, asked one of three scripted questions by the buyer: did they disclose the problem? (IMS Ch. 18)",
  "source": "IMS (Introduction to Modern Statistics)",
  "variables": [
    {
      "name": "question",
      "label": "Question asked",
      "type": "categorical"
    },
    {
      "name": "decision",
      "label": "Seller’s response",
      "type": "categorical"
    }
  ],
  "studyDescription": "Researchers recruited 219 participants to sell a used iPod that was known to have frozen twice. Sellers were incentivised to get as much money as they could. A buyer working with the researchers asked one of three scripted questions, assigned at random: a General question (\"What can you tell me about it?\"), a Positive Assumption (\"It does not have any problems, does it?\"), or a Negative Assumption (\"What problems does it have?\"). The outcome recorded was whether the seller disclosed the freezing issue. This was a randomized experiment.",
  "variableDescriptions": {
    "question": "Which of the three scripted questions the buyer asked, assigned at random.",
    "decision": "Whether the seller disclosed the freezing problem or hid it."
  },
  "sourceDetail": "OpenIntro IMS Ch. 18; openintro::ask. Original study: Minson JA, Ruedy NE, Schweitzer ME (2018), \"There is such a thing as a stupid question: question disclosure in strategic communication\". Replaced on 2026-10-16: this id previously held Frederick et al. (2009) opportunity-cost data (control / give_up / keep × buy / not buy), which is a different study that happens also to have n = 219, under a description naming the iPod experiment (REQ-073 item 3).",
  "context": {
    "population": "sellers in the experiment",
    "parameter": "association between the question asked and whether the problem was disclosed",
    "nullClaim": "the question asked and whether the seller disclosed are independent",
    "successLabel": "Disclose"
  },
